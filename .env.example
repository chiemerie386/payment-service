# Copy to .env and run with: npm run dev   (or: node --env-file=.env dist/server.js)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# "memory" (default) or "file" (JSON file that survives restarts)
PERSISTENCE=memory
DATA_FILE=./data/payments.json

# When true, every new payment is processed in the background automatically.
# Set to false to drive status transitions yourself through PATCH /payments/:id.
AUTO_PROCESS=true

# Simulated gateway behaviour
GATEWAY_MIN_LATENCY_MS=200
GATEWAY_MAX_LATENCY_MS=1200
GATEWAY_DECLINE_RATE=0.2
GATEWAY_ERROR_RATE=0.1

# Processing resilience
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_BACKOFF_MS=200
PROCESSING_ATTEMPT_TIMEOUT_MS=5000
PROCESSING_MAX_CONCURRENCY=10
# How often to look for payments stranded by an error. 0 disables the sweep.
RECOVERY_SWEEP_INTERVAL_MS=30000

# Security
# Comma-separated API keys (16+ characters each). Leave empty to disable
# authentication for local development. Generate one with: openssl rand -hex 32
API_KEYS=
RATE_LIMIT_WINDOW_MS=60000
# Requests per client per window on /payments. 0 disables rate limiting.
RATE_LIMIT_MAX=120

SHUTDOWN_TIMEOUT_MS=10000
